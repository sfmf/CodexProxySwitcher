#include <windows.h>
#include "version.h"
1 ICON "assets/chatgpt-blue.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUMBERS
 PRODUCTVERSION APP_VERSION_NUMBERS
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Codex Proxy Switcher (Native Win32)\0"
   VALUE "ProductName", "Codex Proxy Switcher\0"
   VALUE "FileVersion", APP_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
